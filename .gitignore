# Word temporary and backup files
~$*
*.tmp
*.bak
*.swp
*.lock
*.lck

# Mac system files
.DS_Store

# Windows system files
Thumbs.db
desktop.ini

# KiCad backup and autosave files
*.bak
*.kicad-bak
*.tmp
*.save

# Intermediate files generated by KiCad
*.dcm
*.net
*.xml
*.csv
*.tmp
*.log
*.001

# KiCad project backup folders
_autosave/
backup/

# Gerber and fabrication outputs (optional)
*.gbr
*.gtp
*.gts
*.gbo
*.gbl
*.gbs
*.drl
*.zip
*.pos
*.rep

# Ignore schematic and PCB backup versions
*.sch-bak
*.kicad_sch-bak
*.kicad_pcb-bak

# KiCad user settings (if you're sharing project but want to keep personal UI state out)
*.kicad_prl